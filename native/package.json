{
  "name": "clinovyra-native",
  "version": "3.6.0",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "prepare:web": "node build-web.mjs",
    "android:init": "npm run prepare:web && cap add android && npm run assets:android && npm run android:harden",
    "ios:init": "npm run prepare:web && cap add ios && npm run assets:ios && npm run ios:harden",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'",
    "assets:ios": "capacitor-assets generate --ios --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'",
    "android:sync": "npm run prepare:web && cap sync android && npm run android:harden",
    "android:harden": "node harden-android.mjs",
    "ios:sync": "npm run prepare:web && cap sync ios && npm run ios:harden",
    "ios:harden": "node harden-ios.mjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "desktop:dev": "npm run prepare:web && electron .",
    "desktop:win": "npm run prepare:web && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/ios": "8.0.0",
    "@capgo/capacitor-native-biometric": "8.8.1",
    "@capgo/capacitor-printer": "8.1.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.clinovyra.emr",
    "productName": "Clinovyra EMR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "icon": "www/icons/clinovyra.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "asar": true
  }
}
